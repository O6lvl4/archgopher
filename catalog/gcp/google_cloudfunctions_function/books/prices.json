  "gcp.functions.v1.egress": {
    "unit": "GiB",
    "source": "https://cloud.google.com/functions/pricing-1stgen",
    "note": "Outbound data from a 1st gen function, one SKU per region at the same price. The first 5 GiB a month are free (\"5GB of Internet data transfer out per month\", https://cloud.google.com/functions/pricing-1stgen), part of the billing account's free tier, so counted over the account. Synced from the Billing Catalog, which lists them as a $0 first tier on each region's SKU. us-east5 does not run 1st gen functions.",
