{
  "azure.monitor.alerts.dynamic_threshold": {
    "unit": "time-series-month",
    "source": "https://azure.microsoft.com/pricing/details/monitor/",
    "note": "Dynamic thresholds, per time series, on top of the time series itself. Global meter",
    "sync": {
      "source": "azure",
      "service": "Azure Monitor",
      "filters": {
        "productName": "Azure Monitor",
        "skuName": "Alerts",
        "meterName": "Alerts Dynamic Threshold"
      },
      "region": "Global"
    },
    "values": {
      "*": {
        "value": 0.1,
        "verified": true,
        "checkedAt": "2026-09-25"
      }
    }
  },
  "azure.monitor.alerts.metric_series": {
    "unit": "time-series-month",
    "source": "https://azure.microsoft.com/pricing/details/monitor/",
    "note": "Metric alert, per time series monitored (https://azure.microsoft.com/pricing/details/monitor/). The price list's first tier is a free grant, billed here at the first paid tier's price. Global meter",
    "sync": {
      "source": "azure",
      "service": "Azure Monitor",
      "filters": {
        "productName": "Azure Monitor",
        "skuName": "Alerts",
        "meterName": "Alerts Metric Monitored"
      },
      "region": "Global",
      "tier": "{row}"
    },
    "rows": {
      "0": {
        "*": 0
      },
      "10": {
        "*": 0.1
      }
    },
    "verified": true,
    "checkedAt": "2026-09-25",
    "pool": "account",
    "tiered": true
  }
}
