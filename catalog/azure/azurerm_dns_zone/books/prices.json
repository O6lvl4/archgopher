{
  "azure.dns.record_set_over_10k": {
    "unit": "record set-month",
    "source": "https://azure.microsoft.com/pricing/details/dns/",
    "note": "Record sets in a public zone beyond the 10,000 it includes",
    "sync": {
      "source": "azure",
      "service": "Azure DNS",
      "region": "Zone 1",
      "filters": {
        "productName": "Azure DNS",
        "skuName": "Public Record Set",
        "meterName": "Public Record Set"
      },
      "tier": "10000"
    },
    "values": {
      "*": {
        "value": 0.0015,
        "verified": true,
        "checkedAt": "2026-09-25"
      }
    }
  },
  "azure.dns.zone": {
    "unit": "zone-month",
    "source": "https://azure.microsoft.com/pricing/details/dns/",
    "note": "Public zone per month. Volume tiers count the public zones of the subscription: the first 25 at the list price, every zone from the 26th lower (\"First 25 hosted DNS zones\"; zones and queries are aggregated within an Azure subscription for billing, https://azure.microsoft.com/pricing/details/dns/)",
    "sync": {
      "source": "azure",
      "service": "Azure DNS",
      "region": "Zone 1",
      "filters": {
        "productName": "Azure DNS",
        "skuName": "Public",
        "meterName": "Public Zone"
      },
      "tier": "{row}"
    },
    "rows": {
      "0": {
        "*": 0.5
      },
      "25": {
        "*": 0.1
      }
    },
    "verified": true,
    "checkedAt": "2026-09-25",
    "pool": "account",
    "tiered": true
  }
}
