  "azure.monitor.notifications.email": {
    "unit": "email",
    "per": 100000,
    "source": "https://azure.microsoft.com/pricing/details/monitor/",
    "note": "Email to an email receiver. The first 1,000 a month are free (https://azure.microsoft.com/pricing/details/monitor/), given in the price list as the zero-priced first tier. Global meter: action groups are global, so the free units are counted over every action group of the account (the page does not say more)",
    "sync": {
      "source": "azure",
      "service": "Azure Monitor",
      "filters": {
        "productName": "Azure Monitor",
        "skuName": "Emails",
        "meterName": "Emails"
      },
      "region": "Global",
      "tier": "{row}"
    },
    "rows": {
      "0": {
        "*": 0
      },
      "1000": {
        "*": 2
      }
    },
    "verified": true,
    "checkedAt": "2026-09-25",
    "pool": "account",
    "tiered": true
  },
