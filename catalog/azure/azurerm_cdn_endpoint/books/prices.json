{
  "azure.cdn.microsoft.rule": {
    "unit": "rule-month",
    "source": "https://azure.microsoft.com/pricing/details/cdn/",
    "note": "Azure CDN Standard from Microsoft (classic): each rules engine rule beyond the 5 included, the same in every zone",
    "sync": {
      "source": "azure",
      "service": "Content Delivery Network",
      "region": "Zone 1",
      "filters": {
        "productName": "Azure CDN from Microsoft",
        "skuName": "Standard",
        "meterName": "Standard Rule"
      },
      "tier": "5"
    },
    "values": {
      "*": {
        "value": 1,
        "verified": true,
        "checkedAt": "2026-09-25"
      }
    }
  },
  "azure.cdn.microsoft.rules_requests": {
    "unit": "request",
