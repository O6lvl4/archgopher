{
  "aws.apigateway.http.requests": {
    "unit": "request",
    "per": 1000000,
    "source": "https://aws.amazon.com/api-gateway/pricing/",
    "note": "HTTP API requests, in 512 KB steps. Volume tiers count every HTTP API of the account in the region in a month: from 300 million",
    "sync": {
      "service": "AmazonApiGateway",
      "filters": {
        "usagetype": "((?:[A-Z]+[0-9]|EU)-)?ApiGatewayHttpRequest"
      },
      "tier": "{row}"
    },
    "rows": {
      "0": {
        "ap-northeast-1": 1.29,
        "ap-northeast-2": 1.23,
        "ap-south-1": 1.05,
        "ap-southeast-1": 1.25,
        "ap-southeast-2": 1.29,
        "eu-central-1": 1.2,
        "eu-west-1": 1.11,
        "us-east-1": 1,
        "us-east-2": 1,
        "us-west-2": 1
      },
      "300000000": {
        "ap-northeast-1": 1.18,
        "ap-northeast-2": 1.11,
        "ap-south-1": 0.95,
        "ap-southeast-1": 1.13,
        "ap-southeast-2": 1.18,
        "eu-central-1": 1.08,
        "eu-west-1": 1,
        "us-east-1": 0.9,
        "us-east-2": 0.9,
        "us-west-2": 0.9
      }
    },
    "verified": true,
    "checkedAt": "2026-09-25",
    "pool": "region",
    "tiered": true
  }
}
