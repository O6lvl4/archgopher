{
  "aws.cloudfront.function.invocations": {
    "unit": "invocation",
    "per": 1000000,
    "source": "https://aws.amazon.com/cloudfront/pricing/",
    "note": "CloudFront Functions executions. The price list's first tier is a free grant, billed here at the first paid tier's price. CloudFront is global, so the pool is the account",
    "sync": {
      "service": "AmazonCloudFront",
      "offerRegion": "aws-other",
      "filters": {
        "usagetype": "Executions-CloudFrontFunctions"
      },
      "tier": "{row}"
    },
    "rows": {
      "0": {
        "*": 0
      },
      "2000000": {
        "*": 0.1
      }
    },
    "verified": true,
    "checkedAt": "2026-09-25",
    "pool": "account",
    "tiered": true
  }
}
