{
  "aws.route53.health_check.AWS": {
    "unit": "check-month",
    "source": "https://aws.amazon.com/route53/pricing/",
    "note": "Health check of an AWS endpoint (and calculated, CloudWatch metric and recovery control checks). The price list's first tier is a free grant, billed here at the first paid tier's price",
    "sync": {
      "service": "AmazonRoute53",
      "offerRegion": "aws-other",
      "filters": {
        "usagetype": "Health-Check-AWS"
      },
      "tier": "{row}"
    },
    "rows": {
      "0": {
        "*": 0
      },
      "50": {
        "*": 0.5
      }
    },
    "verified": true,
    "checkedAt": "2026-09-25",
    "pool": "account",
    "tiered": true
  },
  "aws.route53.health_check.Non-AWS": {
    "unit": "check-month",
    "source": "https://aws.amazon.com/route53/pricing/",
    "note": "Health check of an endpoint outside AWS",
    "sync": {
      "service": "AmazonRoute53",
      "offerRegion": "aws-other",
      "filters": {
        "usagetype": "Health-Check-Non-AWS"
      }
    },
    "values": {
      "*": {
        "value": 0.75,
        "verified": true,
        "checkedAt": "2026-09-25"
      }
    }
  },
  "aws.route53.health_check_option": {
    "unit": "feature-month",
    "source": "https://aws.amazon.com/route53/pricing/",
    "note": "Optional feature of a health check (HTTPS, string matching, fast interval, latency measurement)",
    "sync": {
      "service": "AmazonRoute53",
      "filters": {
        "usagetype": "Health-Check-Option-{row}"
      },
      "offerRegion": "aws-other"
    },
    "rows": {
      "AWS": {
        "*": 1
      },
      "Non-AWS": {
        "*": 2
      }
    },
    "verified": true,
    "checkedAt": "2026-09-25"
  }
}
