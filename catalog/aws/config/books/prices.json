{
  "aws.config.evaluations": {
    "unit": "evaluation",
    "source": "https://aws.amazon.com/config/pricing/",
    "note": "Config rule evaluations. Volume tiers from 100,000 and 500,000 evaluations a month, counted over every rule of the account in the region: the pricing page does not say the scope, and the price list lists the tiers in each region's offer. An organization rule is billed in each member account on that account's tiers, so it reads the rows (.0, .100000, .500000) itself",
    "sync": {
      "service": "AWSConfig",
      "filters": {
        "usagetype": "(?:[A-Z]+[0-9]|EU)-ConfigRuleEvaluations"
      },
      "tier": "{row}"
    },
    "rows": {
      "0": {
        "ap-northeast-1": 0.001,
        "ap-northeast-2": 0.001,
        "ap-south-1": 0.001,
        "ap-southeast-1": 0.001,
        "ap-southeast-2": 0.001,
        "eu-central-1": 0.001,
        "eu-west-1": 0.001,
        "us-east-1": 0.001,
        "us-east-2": 0.001,
        "us-west-2": 0.001
      },
      "100000": {
        "ap-northeast-1": 0.0008,
        "ap-northeast-2": 0.0008,
        "ap-south-1": 0.0008,
        "ap-southeast-1": 0.0008,
        "ap-southeast-2": 0.0008,
        "eu-central-1": 0.0008,
        "eu-west-1": 0.0008,
        "us-east-1": 0.0008,
        "us-east-2": 0.0008,
        "us-west-2": 0.0008
      },
      "500000": {
        "ap-northeast-1": 0.0005,
        "ap-northeast-2": 0.0005,
        "ap-south-1": 0.0005,
        "ap-southeast-1": 0.0005,
        "ap-southeast-2": 0.0005,
        "eu-central-1": 0.0005,
        "eu-west-1": 0.0005,
        "us-east-1": 0.0005,
        "us-east-2": 0.0005,
        "us-west-2": 0.0005
      }
    },
    "verified": true,
    "checkedAt": "2026-09-25",
    "pool": "region",
    "tiered": true
  }
}
