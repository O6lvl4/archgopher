{
  "aws.apigateway.rest.requests": {
    "unit": "request",
    "per": 1000000,
    "source": "https://aws.amazon.com/api-gateway/pricing/",
    "note": "REST API requests. Volume tiers count every REST API of the account in the region in a month: from 333 million, 1 billion and 20 billion. ap-southeast-2 lists no 333 million break: its tier from 333 million is its first-tier price, read from the tier that begins at 0",
    "sync": {
      "service": "AmazonApiGateway",
      "filters": {
        "usagetype": "((?:[A-Z]+[0-9]|EU)-)?ApiGatewayRequest"
      },
      "tier": "{row}"
    },
    "rows": {
      "0": {
        "ap-northeast-1": 4.25,
        "ap-northeast-2": 3.5,
        "ap-south-1": 3.5,
        "ap-southeast-1": 4.25,
        "ap-southeast-2": 3.5,
        "eu-central-1": 3.7,
        "eu-west-1": 3.5,
        "us-east-1": 3.5,
        "us-east-2": 3.5,
        "us-west-2": 3.5
      },
      "1000000000": {
        "ap-northeast-1": 3,
        "ap-northeast-2": 2.71,
        "ap-south-1": 2.38,
        "ap-southeast-1": 3,
        "ap-southeast-2": 2.98,
        "eu-central-1": 2.71,
        "eu-west-1": 2.71,
        "us-east-1": 2.38,
        "us-east-2": 2.38,
        "us-west-2": 2.38
      },
      "20000000000": {
        "ap-northeast-1": 1.91,
        "ap-northeast-2": 1.72,
        "ap-south-1": 1.51,
        "ap-southeast-1": 1.91,
        "ap-southeast-2": 1.89,
        "eu-central-1": 1.72,
        "eu-west-1": 1.72,
        "us-east-1": 1.51,
        "us-east-2": 1.51,
        "us-west-2": 1.51
      },
      "333000000": {
        "ap-northeast-1": 3.53,
        "ap-northeast-2": 3.19,
        "ap-south-1": 2.8,
        "ap-southeast-1": 3.53,
        "ap-southeast-2": 3.5,
        "eu-central-1": 3.19,
        "eu-west-1": 3.19,
        "us-east-1": 2.8,
        "us-east-2": 2.8,
        "us-west-2": 2.8
      }
    },
    "verified": true,
    "checkedAt": "2026-09-25",
    "compose": {
      "333000000": {
        "parts": [
          {
            "part": "ApiGatewayRequest",
            "times": 1,
            "withIn": {
              "ap-southeast-2": {
                "tier": "0"
              }
            }
          }
        ]
      }
    },
    "pool": "region",
    "tiered": true
  }
}
